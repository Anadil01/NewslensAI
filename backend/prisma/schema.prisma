generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  email          String           @unique
  passwordHash   String           @map("password_hash")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  role           UserRole         @default(USER)
  bookmarks      Bookmark[]
  readingHistory ReadingHistory[]
  preferences      UserPreference[]
  sourcePreferences UserSourcePreference[]
  feedback StoryFeedback[]
  storySkips StorySkip[]

  @@map("users")
}

model Story {
  id                 String         @id @default(uuid()) @db.Uuid
  sourceId           String         @map("source_id") @db.Uuid
  externalId         String         @map("external_id")
  canonicalUrl       String         @map("canonical_url")

  title              String
  author             String?
  content            String?
  excerpt            String?

  imageUrl           String?        @map("image_url")
  readingTimeSeconds Int?           @map("reading_time_seconds")

  contentStatus      ContentStatus  @default(EXTERNAL_ONLY) @map("content_status")
  publishedAt        DateTime?      @map("published_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  clusterId          String?        @map("cluster_id") @db.Uuid
  points             Int?

  aiSummaries        AISummary[]
  biasAnalysis       BiasAnalysis?
  bookmarks          Bookmark[]
  readingHistory     ReadingHistory[]

  feedback           StoryFeedback[]
  cluster            StoryCluster?  @relation(fields: [clusterId], references: [id])
  source             sources        @relation(fields: [sourceId], references: [id])

  storyTopics        StoryTopic[]
  storySkips         StorySkip[]

  @@unique([sourceId, externalId])
  @@index([sourceId, publishedAt(sort: Desc)])
  @@index([publishedAt(sort: Desc)])
  @@index([clusterId])
  @@map("stories")
}


model Bookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  storyId   String   @map("story_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@map("bookmarks")
}

model ReadingHistory {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  storyId         String   @map("story_id") @db.Uuid
  openedAt        DateTime @default(now()) @map("opened_at")
  durationSeconds Int?     @map("duration_seconds")
  completed       Boolean  @default(false)
  story           Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, openedAt(sort: Desc)])
  @@map("reading_history")
}

model StoryFeedback {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  storyId   String       @map("story_id") @db.Uuid
  feedback  FeedbackType
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@index([userId, feedback])
  @@map("story_feedback")
}

enum FeedbackType {
  LIKE
  DISLIKE
}

model StorySkip {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  storyId   String   @map("story_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@index([userId])
  @@map("story_skips")
}

model Topic {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  createdAt   DateTime         @default(now()) @map("created_at")
  storyTopics StoryTopic[]
  preferences UserPreference[]

  @@map("topics")
}

model StoryTopic {
  storyId String @map("story_id") @db.Uuid
  topicId String @map("topic_id") @db.Uuid
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([storyId, topicId])
  @@index([topicId, storyId])
  @@map("story_topics")
}

model StoryCluster {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  stories     Story[]

  @@map("story_clusters")
}

model UserPreference {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  topicId    String   @map("topic_id") @db.Uuid
  preference Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("user_preferences")
}

model UserSourcePreference {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  sourceId   String   @map("source_id") @db.Uuid
  preference Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  source sources @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceId])
  @@index([sourceId])
  @@map("user_source_preferences")
}

model AISummary {
  id           String   @id @default(uuid()) @db.Uuid
  storyId      String   @map("story_id") @db.Uuid
  summary      String
  keyPoints    Json?    @map("key_points")
  whyItMatters String?  @map("why_it_matters")
  whatNext     String?  @map("what_next")
  model        String
  version      String
  createdAt    DateTime @default(now()) @map("created_at")
  entities     Json?
  story        Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, model, version])
  @@map("ai_summaries")
}

model BiasAnalysis {
  id         String   @id @default(uuid()) @db.Uuid
  storyId    String   @unique @map("story_id") @db.Uuid
  biasScore  Float    @map("bias_score")
  tone       String
  confidence Float
  signals    String?
  createdAt  DateTime @map("created_at") @db.Timestamp(6)
  story      Story    @relation(fields: [storyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("bias_analysis")
}

model scrape_runs {
  id           String          @id @db.Uuid
  source_id    String          @db.Uuid
  started_at   DateTime        @default(now())
  completed_at DateTime?
  duration_ms  Int?
  status       ScrapeRunStatus @default(RUNNING)
  fetched      Int             @default(0)
  inserted     Int             @default(0)
  updated      Int             @default(0)
  skipped      Int             @default(0)
  error        String?
  sources      sources         @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@index([source_id, started_at(sort: Desc)])
  @@index([status])
}

model sources {
  id               String              @id @db.Uuid
  name             String
  slug             String              @unique
  websiteUrl       String              @map("website_url")
  type             SourceType
  isActive         Boolean             @default(true) @map("is_active")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @map("updated_at")
  politicalLean    SourcePoliticalLean @default(UNKNOWN) @map("political_lean")
  reliabilityScore Float?              @map("reliability_score")

  scrape_runs scrape_runs[]
  stories          Story[]
  userPreferences  UserSourcePreference[]

  @@map("sources")
}


enum SourcePoliticalLean {
  LEFT
  CENTER_LEFT
  CENTER
  CENTER_RIGHT
  RIGHT
  UNKNOWN
}

enum UserRole {
  USER
  ADMIN
}

enum SourceType {
  WEBSITE
  RSS
  API
}

enum ContentStatus {
  FULL
  SUMMARY_ONLY
  EXTERNAL_ONLY
}

enum ScrapeRunStatus {
  RUNNING
  SUCCESS
  FAILED
}
